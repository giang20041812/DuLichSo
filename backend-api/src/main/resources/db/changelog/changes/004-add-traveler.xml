<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="004-create-traveler" author="dulichso">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="traveler"/>
            </not>
        </preConditions>
        <createTable tableName="traveler"
                     remarks="Tài khoản khách du lịch (đăng ký email hoặc đăng nhập Google), tách biệt account ADMIN/PROVIDER">
            <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_traveler_email"/>
            </column>
            <column name="phone" type="VARCHAR(32)">
                <constraints unique="true" uniqueConstraintName="uq_traveler_phone"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)" remarks="NULL nếu chỉ đăng nhập bằng Google"/>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="picture_url" type="VARCHAR(1000)"/>
            <column name="last_login_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
