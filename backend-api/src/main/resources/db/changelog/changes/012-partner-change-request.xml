<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">
  <!--
    Yêu cầu thay đổi của NCC (thông tin Homestay, loại phòng, giá) đối với Homestay đang công khai.
    NCC gửi yêu cầu → PENDING → Admin xem nội dung cũ/mới → APPROVED (mới ghi vào dữ liệu chính thức) hoặc REJECTED.
  -->
  <changeSet id="012-create-partner-change-request" author="claude">
    <createTable tableName="partner_change_request" remarks="Yêu cầu thay đổi Homestay/phòng/giá của NCC chờ Admin duyệt">
      <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="provider_id" type="BIGINT UNSIGNED">
        <constraints nullable="false" foreignKeyName="fk_pcr_provider" references="provider(id)"/>
      </column>
      <column name="place_id" type="BIGINT UNSIGNED">
        <constraints nullable="false" foreignKeyName="fk_pcr_place" references="place(id)"/>
      </column>
      <column name="target_type" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
      <column name="target_id" type="BIGINT UNSIGNED"/>
      <column name="room_type_id" type="BIGINT UNSIGNED"/>
      <column name="operation" type="VARCHAR(8)">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="VARCHAR(16)" defaultValue="PENDING">
        <constraints nullable="false"/>
      </column>
      <column name="payload" type="JSON"/>
      <column name="before_data" type="JSON"/>
      <column name="submitted_by" type="BIGINT UNSIGNED">
        <constraints nullable="false" foreignKeyName="fk_pcr_submitted_by" references="account(id)"/>
      </column>
      <column name="submitted_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="reviewed_by" type="BIGINT UNSIGNED">
        <constraints foreignKeyName="fk_pcr_reviewed_by" references="account(id)"/>
      </column>
      <column name="reviewed_at" type="DATETIME"/>
      <column name="review_note" type="VARCHAR(500)"/>
    </createTable>
    <createIndex tableName="partner_change_request" indexName="idx_pcr_status_submitted">
      <column name="status"/>
      <column name="submitted_at"/>
    </createIndex>
    <createIndex tableName="partner_change_request" indexName="idx_pcr_provider_status">
      <column name="provider_id"/>
      <column name="status"/>
    </createIndex>
    <createIndex tableName="partner_change_request" indexName="idx_pcr_place">
      <column name="place_id"/>
      <column name="status"/>
    </createIndex>
    <rollback>
      <dropTable tableName="partner_change_request"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
