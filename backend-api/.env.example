# Backend Environment Variables Example

# Application Setup
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking_db
DB_USERNAME=postgres
DB_PASSWORD=secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secret
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRATION_MS=86400000 # 24 hours

# AI Configuration (Gemini API)
GEMINI_API_KEY=your_gemini_api_key

# Payment Integration (SEPay)
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_for_validation
SEPAY_API_TOKEN=your_sepay_api_token

# Google Maps API (Backend usage for Distance Matrix)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_server

# Active Media Provider (CLOUDINARY or CLOUDFLARE_IMAGES)
ACTIVE_MEDIA_PROVIDER=CLOUDINARY

# Cloudflare Images Setup
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudinary Setup (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_firebase_server_key_or_path_to_service_account_json

# Feature Flags
ENABLE_ONLINE_PAYMENT=true
ENABLE_REDIRECT_BOOKING=true
ENABLE_CARPOOL=false

# Google OAuth2 Login
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# --- Deploy ---
# Origin của frontend (cách nhau bởi dấu phẩy, KHÔNG dùng *). Ví dụ: https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Tài khoản mẫu QA — để false trên production
APP_QA_MOCK_ACCOUNTS=false
