# Frontend Environment Variables Example (Vite)

# Origin của backend khi frontend & backend KHÁC domain (vd https://api.example.com).
# Để trống nếu có reverse proxy cùng domain chuyển /api -> backend (khuyến nghị) hoặc khi chạy dev.
VITE_API_ORIGIN=

# Google Maps API (Client Restricted Key)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_client

# Cloudinary Upload Setup
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Google OAuth2 Login
VITE_GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Firebase Client SDK (Google One-Click Authentication & Notifications)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
